{
  "name": "gulden",
  "version": "3.23.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node server/index.js\" \"npm --prefix client run dev\"",
    "build": "npm --prefix client run build",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "test:coverage": "c8 --reporter=text --reporter=lcov npm test",
    "lint": "eslint .",
    "format:check": "prettier --check \"server/**/*.{js,mjs}\" \"client/src/**/*.{js,jsx}\" \"tests/**/*.js\" \"tests/e2e/**/*.js\" \"scripts/**/*.{js,mjs}\" \"docs/openapi.json\" \"*.config.js\" \"client/*.config.js\"",
    "format": "prettier --write \"server/**/*.{js,mjs}\" \"client/src/**/*.{js,jsx}\" \"tests/**/*.js\" \"tests/e2e/**/*.js\" \"scripts/**/*.{js,mjs}\" \"docs/openapi.json\" \"*.config.js\" \"client/*.config.js\""
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "multer": "^2.2.0",
    "papaparse": "^5.5.3",
    "xlsx": "npm:@e965/xlsx@0.20.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "c8": "^12.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.6"
  }
}
