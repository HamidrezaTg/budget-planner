<?xml version="1.0" encoding="utf-8"?>
<!-- Pre-Android-12 equivalent of data_extraction_rules.xml: exclude everything
     from auto backups. -->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
</full-backup-content>
