# PKGBUILD for budget-planner-client (Tauri v2, Arch Linux).
# Maintainer: HamidrezaTg <hamidreza@users.noreply.github.com>
# AUR package name: budget-planner-client
# Built from the GitHub release artifacts (the official .deb or AppImage)
# rather than from source so the Rust toolchain isn't required at install
# time. The .deb path is preferred; AppImage is the fallback.
#
# To bump: update pkgver to match the GitHub release tag and `updpkgsums`.
pkgname=budget-planner-client
pkgver=3.15.0
pkgrel=1
pkgdesc="Desktop client for a self-hosted Budget Planner server (Tauri v2, no backend)"
arch=('x86_64')
url="https://github.com/HamidrezaTg/budget-planner"
license=('MIT')
depends=('gtk3' 'libsoup3' 'webkit2gtk-4.1' 'libappindicator' 'librsvg' 'hicolor-icon-theme' 'desktop-file-utils' 'xdg-utils')
makedepends=('binutils')
options=('!strip')
install=budget-planner-client.install
source=("https://github.com/HamidrezaTg/budget-planner/releases/download/v3.15.0/budget-planner-client_3.15.0_amd64.deb")
# Update the sha256 below with `makepkg -g >> PKGBUILD && updpkgsums`.
sha256sums=('fa56d0ebfda0ff6254da3a9a7456e16bd31047de233383feb73f2f140b941abf')

package() {
  local deb_file
  local -a deb_files=("$srcdir"/*.deb)
  if (( ${#deb_files[@]} != 1 )); then
    error "expected exactly one downloaded .deb"
  fi
  deb_file=${deb_files[0]}
  mkdir -p "$srcdir/deb"
  (cd "$srcdir/deb" && ar -x "$deb_file")
  # Extract the data archive without executing Debian maintainer scripts.
  tar -xf "$srcdir"/deb/data.tar.* -C "$pkgdir"
}
